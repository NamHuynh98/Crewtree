  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@crewtree/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.39.3",
    "fast-glob": "^3.3.3",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/picomatch": "^3.0.2",
    "drizzle-kit": "^0.30.4",
